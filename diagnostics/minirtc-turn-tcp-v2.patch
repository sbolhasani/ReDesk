+// Only the stage of a libnice message is retained; the original may
+// contain network addresses and TURN authentication material.
+void TurnDiagLibniceLog(const gchar*, GLogLevelFlags, const gchar* message,
+                        gpointer) {
+  if (!message) return;
+  const std::string_view value(message);
+  const auto has = [&](const char* term) {
+    return value.find(term) != std::string_view::npos;
+  };
+  const char* stage =
+      has("conncheck") || has("conn check") || has("connectivity") ||
+              has("pair")
+          ? "ice_check"
+          : has("TURN") || has("turn") || has("allocat") || has("relay")
+                ? "turn"
+                : has("STUN") || has("stun") ? "stun" : nullptr;
+  if (!stage) return;
+  const char* outcome =
+      has("fail") || has("error") || has("timeout") || has("refused")
+          ? "failure"
+          : has("success") || has("succeed") || has("response")
+                ? "response"
+                : "progress";
+  static std::atomic<unsigned> count{0};
+  const unsigned n = count.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (n <= 200 || n % 200 == 0)
+    LOG_INFO("TURN_DIAG libnice stage={} outcome={} event={} (raw details withheld)",
+             stage, outcome, n);
+}
+
+void EnableTurnDiagLibniceLog() {
+  const char* flag = std::getenv("REDESK_TURN_DIAG_ICE_LOG");
+  if (!flag || std::string_view(flag) != "1") return;
+  static const bool installed = [] {
+    g_log_set_handler("libnice", G_LOG_LEVEL_MASK, TurnDiagLibniceLog, nullptr);
+    g_log_set_handler("libnice-stun", G_LOG_LEVEL_MASK, TurnDiagLibniceLog,
+                      nullptr);
+    LOG_INFO("TURN_DIAG libnice bridge installed; set NICE_DEBUG and G_MESSAGES_DEBUG before startup");
+    return true;
+  }();
+  (void)installed;
+}
+
+void TurnDiagGatheringDone(NiceAgent* agent, guint stream, gpointer) {
+  GSList* list = nice_agent_get_local_candidates(
+      agent, stream, NICE_COMPONENT_TYPE_RTP);
+  unsigned relay4 = 0, relay6 = 0, nonrelay = 0;
+  for (GSList* item = list; item; item = item->next) {
+    const auto* candidate = static_cast<const NiceCandidate*>(item->data);
+    if (candidate->type != NICE_CANDIDATE_TYPE_RELAYED) {
+      ++nonrelay;
+      continue;
+    }
+    if (nice_address_ip_version(&candidate->addr) == 6) ++relay6;
+    else ++relay4;
+  }
+  g_slist_free_full(
+      list, reinterpret_cast<GDestroyNotify>(nice_candidate_free));
+  LOG_INFO("TURN_DIAG gathered local_relay_ipv4={} local_relay_ipv6={} nonrelay={}",
+           relay4, relay6, nonrelay);
+}
